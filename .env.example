# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ANTHROPIC_API_KEY: khóa Claude cho tính năng "Gợi ý từ hồ sơ" (chỉ đặt ở server, file .env không commit).
# ANTHROPIC_API_KEY=

# CRM billing/events integration. Backend-only; never expose these in the Vite bundle.
CRM_BASE_URL=https://crm.robusltd.com
CRM_SOURCE_KEY=maps_landing
CRM_WEBSITE_KEY=maps_landing_30f46283e1309857
CRM_CHECKOUT_API_KEY=
CRM_CALLBACK_API_KEY=
CRM_PAYMENT_CONFIG_KEY=maps_landing_manual_bank_transfer
CRM_SKU_BASIC_MONTHLY=maps01
CRM_SKU_BASIC_ANNUAL=maps02
CRM_SKU_ADVANCED_MONTHLY=maps03
CRM_SKU_ADVANCED_ANNUAL=maps04
