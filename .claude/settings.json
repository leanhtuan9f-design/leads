{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== BẮT BUỘC: bản đồ repo (/home/claude/repo-maps.md). Đọc trước khi làm; cập nhật khi xong nhiệm vụ. ===' && cat /home/claude/repo-maps.md"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./deploy.sh)",
      "Bash(/opt/maps/deploy.sh)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git pull --ff-only*)",
      "Bash(git push origin main)",
      "Bash(git status*)",
      "Bash(npx tsc --noEmit)"
    ],
    "deny": [
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
