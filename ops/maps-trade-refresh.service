[Unit]
Description=Refresh Vietnam export market snapshots from GSO
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/leads
EnvironmentFile=/etc/maps/trade-refresh.env
ExecStart=/usr/bin/node /opt/leads/server/trade-refresh-all.mjs
TimeoutStartSec=10min
